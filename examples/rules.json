{
  "version": 1,
  "rules": [
    {
      "name": "public-repositories",
      "match": {
        "events": ["issues", "pull_request"],
        "actions": ["opened"],
        "repository_owner": "example-org",
        "repository_private": false
      },
      "actions": [{"type": "add_to_project", "project": {"owner": "example-org", "number": 1}}]
    },
    {
      "name": "private-repositories",
      "match": {
        "events": ["issues", "pull_request"],
        "actions": ["opened"],
        "repository_owner": "example-org",
        "repository_private": true
      },
      "actions": [{"type": "add_to_project", "project": {"owner": "example-org", "number": 2}}]
    }
  ]
}
